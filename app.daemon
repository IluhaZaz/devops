# /etc/systemd/system/donjulio.service
[Unit]
Description=Don Julio Pub Django App
After=network.target

[Service]
Type=simple
User=ilie
Group=ilie
WorkingDirectory=/home/ilie/Documents/devops/DonJulioPub/don_julio_pub
Environment=PYTHONPATH=/home/ilie/Documents/devops/DonJulioPub
Environment=DJANGO_SETTINGS_MODULE=don_julio_pub.settings
ExecStart=/usr/bin/python3 manage.py runserver 0.0.0.0:8181
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
